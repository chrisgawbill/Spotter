# Example only: replace the user, paths and Tailscale address before installing.
[Unit]
Description=Spotter Tailscale dashboard
After=docker.service tailscaled.service
Requires=docker.service

[Service]
Type=simple
User=spotter
WorkingDirectory=/home/spotter/projects/Spotter
Environment=SPOTTER_TAILSCALE_IP=100.64.0.1
Environment=SPOTTER_HOME=/home/spotter/spotter
#Environment=SPOTTER_KEEP_RUNS=10
#Environment=SPOTTER_KEEP_BASELINES=5
#Environment=SPOTTER_AUTO_PRUNE=on
ExecStart=/home/spotter/projects/Spotter/bin/spotter dashboard
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
